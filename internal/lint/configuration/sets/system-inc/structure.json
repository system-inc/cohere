{
    "extends": "cohere:typescript",
    "plugins": ["@typescript-eslint", "react", "react-hooks", "@next"],
    "rules": {
        "@next/next/google-font-display": "error",
        "@next/next/google-font-preconnect": "error",
        "@next/next/inline-script-id": "error",
        "@next/next/next-script-for-ga": "error",
        "@next/next/no-assign-module-variable": "error",
        "@next/next/no-async-client-component": "error",
        "@next/next/no-before-interactive-script-outside-document": "error",
        "@next/next/no-css-tags": "error",
        "@next/next/no-document-import-in-page": "error",
        "@next/next/no-duplicate-head": "error",
        "@next/next/no-head-element": "error",
        "@next/next/no-head-import-in-document": "error",
        "@next/next/no-html-link-for-pages": "error",
        "@next/next/no-img-element": "error",
        "@next/next/no-location-assign-relative-destination": "error",
        "@next/next/no-page-custom-font": "error",
        "@next/next/no-script-component-in-head": "error",
        "@next/next/no-styled-jsx-in-document": "error",
        "@next/next/no-sync-scripts": "error",
        "@next/next/no-title-in-document-head": "error",
        "@next/next/no-typos": "error",
        "@next/next/no-unwanted-polyfillio": "error",
        "react-hooks/config": "error",
        "react/forward-ref-uses-ref": "error",
        "react-hooks/error-boundaries": "error",
        "react/no-did-mount-set-state": "error",
        "react/no-did-update-set-state": "error",
        "react-hooks/exhaustive-deps": "error",
        "react-hooks/gating": "error",
        "react-hooks/globals": "error",
        "react-hooks/immutability": "error",
        "react/jsx-no-duplicate-props": "error",
        "react/jsx-no-undef": "error",
        "react/jsx-props-no-spread-multi": "error",
        "react-hooks/incompatible-library": "error",
        "react/no-children-prop": "error",
        "react/no-danger-with-children": "error",
        "react/no-direct-mutation-state": "error",
        "react/no-find-dom-node": "error",
        "react/no-string-refs": "error",
        "react/no-this-in-sfc": "error",
        "react/no-unsafe": "error",
        "react/no-will-update-set-state": "error",
        "react-hooks/preserve-manual-memoization": "error",
        "react-hooks/purity": "error",
        "react-hooks/refs": "error",
        "react-hooks/rules-of-hooks": "error",
        "react-hooks/set-state-in-effect": "error",
        "react-hooks/set-state-in-render": "error",
        "react-hooks/static-components": "error",
        "react-hooks/unsupported-syntax": "error",
        "react-hooks/use-memo": "error",
        "react-hooks/void-use-memo": "error",
        "nexus/consistency-no-abbreviated-identifier": [
            "error",
            {
                "frameworkParameterFilePatterns": ["/page.tsx", "/page.jsx", "/layout.tsx", "/layout.jsx", "/route.ts"],
                "frameworkConstantFilePatterns": ["/middleware.ts", "middleware.ts"],
                "frameworkParameterScopeNames": ["generateMetadata", "generateStaticParams", "generateViewport"],
                "frameworkParameterScopeSuffixes": ["PageRoute"]
            }
        ],
        "nexus/consistency-require-constant-casing": [
            "error",
            {
                "frameworkConstantNames": [
                    "dynamic",
                    "dynamicParams",
                    "revalidate",
                    "fetchCache",
                    "runtime",
                    "preferredRegion",
                    "maxDuration",
                    "metadata",
                    "viewport",
                    "generateMetadata",
                    "config",
                    "alt",
                    "size",
                    "contentType",
                    "plugin",
                    "schema"
                ]
            }
        ],
        "structure/boundary-no-project-theme-value": "error",
        "structure/consistency-no-property-alias": "error",
        "structure/consistency-organize-imports": "error",
        "structure/network-no-direct-fetch": "error",
        "structure/network-no-forbidden-import": "error",
        "structure/network-no-invalidate-cache-in-on-success": "error",
        "structure/network-no-invalidate-cache-literal-key": "error",
        "structure/network-no-string-literal-query": "error",
        "structure/network-require-hook-options-parameter": "error",
        "structure/network-require-hook-request-suffix": "error",
        "structure/network-require-hook-variables-type": "error",
        "structure/next-no-near-miss-route-export": "error",
        "structure/next-no-page-state": "error",
        "structure/next-require-api-parameter-name": "error",
        "structure/next-require-page-default-export": "error",
        "structure/react-component-no-const-assignment": "error",
        "structure/react-component-no-destructuring": "error",
        "structure/react-component-no-display-name": "error",
        "structure/react-component-no-forward-ref": "error",
        "structure/react-component-no-separate-named-export": "error",
        "structure/react-component-require-matching-file-name": "error",
        "structure/react-component-require-named-export": "error",
        "structure/react-component-require-properties-parameter": "error",
        "structure/react-component-require-properties-type-suffix": "error",
        "structure/react-hook-any-type": "error",
        "structure/react-hook-no-destructuring": "error",
        "structure/react-hook-no-properties-in-dependencies": "error",
        "structure/react-hook-require-effect-comment": "error",
        "structure/react-hook-require-result-naming": "error",
        "structure/react-import-no-destructuring": "error",
        "structure/react-no-anchor-element": "error",
        "structure/react-no-horizontal-rule-element": "error",
        "structure/storage-no-direct-local-storage": "error",
        "structure/tailwind-no-physical-direction": "error",
        "better-tailwindcss/enforce-canonical-classes": "error",
        "better-tailwindcss/enforce-consistent-class-order": "error",
        "better-tailwindcss/enforce-consistent-variant-order": "error",
        "better-tailwindcss/enforce-consistent-important-position": "error",
        "better-tailwindcss/enforce-consistent-variable-syntax": "error",
        "better-tailwindcss/enforce-shorthand-classes": "error",
        "better-tailwindcss/no-concatenated-classes": "error",
        "better-tailwindcss/no-conflicting-classes": "error",
        "better-tailwindcss/no-deprecated-classes": "error",
        "better-tailwindcss/no-duplicate-classes": "error",
        "better-tailwindcss/no-unknown-classes": "error",
        "better-tailwindcss/no-unnecessary-whitespace": "error",
        "react/jsx-key": "off",
        "react/no-is-mounted": "error",
        "react/no-render-return-value": "error",
        "react/void-dom-elements-no-children": "error",
        "react/no-unescaped-entities": "error",
        "react/require-render-return": "error",
        "react-hooks/no-deriving-state-in-effects": "error",
        "react/no-deprecated": "error",
        "react/jsx-no-target-blank": "error",
        "react/checked-requires-onchange-or-readonly": "error",
        "react/button-has-type": "error",
        "react/state-in-constructor": "error",
        "react/jsx-no-comment-textnodes": "error",
        "react/prefer-es6-class": "error",
        "react/no-namespace": "error",
        "react/no-redundant-should-component-update": "error",
        "react/no-danger": "error",
        "react/no-multi-comp": "error",
        "react/no-set-state": "error",
        "react/self-closing-comp": "error",
        "react/no-object-type-as-default-prop": "error",
        "react/iframe-missing-sandbox": "error",
        "react/forbid-foreign-prop-types": "error",
        "react/forbid-elements": "error",
        "react/no-adjacent-inline-elements": "error",
        "react/jsx-no-script-url": "error",
        "react/forbid-dom-props": "error",
        "react/style-prop-object": "error",
        "react/no-arrow-function-lifecycle": "error",
        "react/jsx-fragments": "error",
        "react/prefer-stateless-function": "error",
        "react/require-optimization": "error",
        "react/jsx-no-constructed-context-values": "error",
        "react/no-access-state-in-setstate": "error",
        "react/no-unused-class-component-methods": "error",
        "react/static-property-placement": "error",
        "react/no-array-index-key": "error",
        "react/jsx-no-useless-fragment": "error",
        "react/sort-default-props": "error",
        "react/display-name": "error",
        "react/forbid-prop-types": "error",
        "react/no-typos": "error",
        "react/no-unstable-nested-components": "error",
        "react/no-unknown-property": "error",
        "react/no-unused-state": "error",
        "react/default-props-match-prop-types": "error"
    },
    "ignorePatterns": [
        "code-quality/fixtures/**",
        "node_modules/**",
        "public/**",
        "**/.next/**",
        "**/.open-next/**",
        "**/.worker-next/**",
        "**/.wrangler/**",
        "**/build/**",
        "**/dist/**",
        "**/*.code.js",
        ".vscode/**",
        ".claude/worktrees/**"
    ],
    "overrides": [
        {
            "files": ["**/generated/**/*.{ts,tsx}"],
            "rules": {
                "nexus/consistency-no-abbreviated-identifier": "off",
                "nexus/consistency-require-type-suffix": "off",
                "@typescript-eslint/no-explicit-any": "off"
            }
        },
        {
            "files": ["**/graphql/GraphQl*.generated.ts"],
            "reason": "Interim, until the last open decision on the generated-code ruling (#c076xbg) lands: the GraphQL schema itself names fields like min, max and idx, a wire change waiting on Kirk because the Phi mobile app may read them. When it lands, this override is deleted.",
            "rules": {
                "nexus/consistency-no-abbreviated-identifier": "off"
            }
        },
        {
            "files": ["**/next-env.d.ts"],
            "rules": {
                "structure/consistency-organize-imports": "off"
            }
        }
    ]
}
