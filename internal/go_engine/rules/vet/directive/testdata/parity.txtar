// A test file of the package: its header is valid.
//go:debug panicnil=1

/* a block comment ends nothing in a Go file */

//go:debug panicnil=1
package parity

// After the clause: only valid before package declaration.
//go:debug panicnil=1

/*
//go:debug in a block comment is clean.
*/
-- src/parity/external_test.go --
//go:debug panicnil=1
package parity_test

//go:debug panicnil=1 // only valid before package declaration
-- src/parity/line_directive.go --
// A //line directive renames the file in positions, and the file's own name still decides whether it is a test: this
// file is not one, though it says it is.
//line renamed_test.go:1
//go:debug panicnil=1
package parity
