A module at a prerelease of Go 1.22, a valid version at language version go1.22, so an untagged file declares its
loop variables afresh on every iteration, and one whose //go:build line names Go 1.21 is checked at Go 1.21.

-- go.mod --
module golang.org/fake/versions

go 1.22rc1
-- module.go --
package versions

import "sync"

func AtTheModuleVersion(mutex sync.Mutex) {
	for index, loopMutex := 0, (sync.Mutex{}); index < 1; index++ {
		_ = loopMutex.TryLock()
	}
	for loopMutex := mutex; ; {
		_ = loopMutex.TryLock()
		break
	}
}
-- downgraded.go --
//go:build go1.21

package versions

import "sync"

func AtGo121ByItsBuildLine() {
	for index, loopMutex := 0, (sync.Mutex{}); index < 1; index++ {
		_ = loopMutex.TryLock()
	}
}
