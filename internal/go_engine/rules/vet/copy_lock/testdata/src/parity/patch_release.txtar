A module at a patch release of Go 1.21: its language version is go1.21, so an untagged file shares its loop
variables across iterations, and a file whose //go:build line names a later version is checked at that one.

-- go.mod --
module golang.org/fake/versions

go 1.21.5
-- module.go --
package versions

import "sync"

func AtTheModuleVersion(mutex sync.Mutex) {
	for index, loopMutex := 0, (sync.Mutex{}); index < 1; index++ {
		_ = loopMutex.TryLock()
	}
	for loopMutex := mutex; ; {
		_ = loopMutex.TryLock()
		break
	}
}
-- upgraded.go --
//go:build go1.22

package versions

import "sync"

func AtGo122ByItsBuildLine() {
	for index, loopMutex := 0, (sync.Mutex{}); index < 1; index++ {
		_ = loopMutex.TryLock()
	}
}
