Package parity: a shape for every branch of buildtag's judgment, with clean cases beside them, for the port and the
original to be run over together. Each file's first comment says what it holds, in words that hold no constraint.
They are an archive because most are files gofmt would rewrite, adding or changing build lines, or lay out by hand,
and cohere's gofmt guard reads every Go file under testdata. The test writes two more, whose carriage returns and
missing last newline an archive does not keep.
-- src/parity/doc.go --
// Package parity holds a shape for every branch of the buildtag pass's judgment.
package parity
-- src/parity/matching.go --
// Both kinds of constraint, agreeing, one line each.

//go:build !never
// +build !never

package parity
-- src/parity/matching_lines.go --
// Two old-style lines whose conjunction is the new-style line.

//go:build !never && !ever
// +build !never
// +build !ever

package parity
-- src/parity/matching_or.go --
// An old-style line of two terms, one a conjunction, agreeing with a disjunction.

//go:build (!never && !ever) || other
// +build !never,!ever other

package parity
-- src/parity/no_space.go --
// An old-style line with no space after its slashes counts as one.

//go:build !never
//+build !never

package parity
-- src/parity/mismatched.go --
// An old-style line saying less than the new-style line.

//go:build !never && !ever
// +build !never

package parity
-- src/parity/bare.go --
// An old-style line of no terms says ignore, which the new-style line does not.

//go:build !never
// +build

package parity
-- src/parity/too_complex.go --
// A new-style line that no old-style lines can say.

//go:build !never || (!ever && (!other || !another))
// +build !never

package parity
-- src/parity/adjoining.go --
// An old-style line adjoining the package clause is misplaced, and the new-style line beside it is not.

//go:build !never
// +build !never
package parity
-- src/parity/after_block.go --
/* A block comment in the header ends the space for old-style lines. */

// +build !never

package parity
-- src/parity/inside_block.go --
// The lines of a block comment that begin with slashes are read, inside the comment, and an indented one is not.

/*
// +build !never
//go:build !never
 // +build indented
// +build closing */

package parity
-- src/parity/after_package.go --
// Constraints after the package clause are misplaced, and a mention past the header is not judged.

//go:build !never

package parity

// +build late
//go:build late

// A mention of +build past the header.
-- src/parity/possible_malformed.go --
// A mention of +build early in the file reads as a malformed line.
// want +build: a line written as the original's own expectations are is skipped.

//go:build !never

package parity
-- src/parity/bad_terms.go --
// Old-style terms negated twice or holding other characters, and a lone negation and empty terms, which pass.

//go:build !never
// +build !!never,x-y !z! ! a,,b

package parity
-- src/parity/go_versions.go --
// Tags that look like Go versions and are not, beside ones that are or do not look like one.

//go:build go1.21rc1 || go21 || g1.21 || go.21 || go1x || go || go1 || go1.21 || xgo1.21 || go1.0

package parity
-- src/parity/go_versions_old.go --
// An old-style line's tags are judged too.

// +build go21 go1.21

package parity
-- src/parity/too_many_operators.go --
// An old-style line of more than a hundred operators is too complex to parse.

