-- src/parity/malformed_space.go --
//go:build !never

package parity

// go:build linux, written //go:build style, has a space after its slashes.
// A comment naming //go:build lines is not one.
//go:buildtag is not a constraint either.
-- src/parity/extra.go --
// A second new-style line, which the go command does not read behind the close of a block comment, is one too many.

//go:build !never
/*
*/ //go:build !ever

package parity
-- src/parity/parse_error.go --
// A new-style line that does not parse, behind the close of a block comment, where the go command does not read it.

/*
*/ //go:build (!never

package parity
-- src/parity/error_hack.go --
// The original's testing hack: what follows a spaced `// ERROR` comment is not part of the constraint.

// +build !never // ERROR comments after a constraint are cut

/*
*/ //go:build !never // ERROR cut before parsing

package parity
-- src/parity/excluded.go --
// A file the build excludes is read too.

//go:build never

// +build !!never

package parity
-- src/parity/parity_test.go --
// A test file's constraints are judged as any file's.

//go:build !never
// +build never

package parity
-- src/parity/external_test.go --
// An external test's mention of +build early in the file.

package parity_test
