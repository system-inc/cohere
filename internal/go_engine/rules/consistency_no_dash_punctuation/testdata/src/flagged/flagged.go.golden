// Package flagged holds a dash written as itself in every place the rule reads one. A want rides on the line the dash
// sits on, and a dash on a later line of a block comment or a raw string is wanted from the line above it with +1 or
// +2, so each case also proves the report lands on the dash's own line rather than the comment's or the literal's
// first. flagged.go.golden beside it is this file with every offered fix applied: each dash in an interpreted string
// written as its escape, and the comments and raw strings as they were, since nothing is offered for them.
package flagged

// Measure is the one function here — and its doc comment carries the dash. // want `^This is an em-dash\.`
func Measure() int { return 1 }

// a line comment with a page range, 3–7, inside it // want `^This is an en-dash\.`

// two dashes — one comment — two findings // want `^This is an em-dash\.` `^This is an em-dash\.`

/* a block comment — on one line */ // want `^This is an em-dash\.`

// want +2 `^This is an en-dash\.`
/*
 * a block comment whose second line holds the dash, pages 3–7
 */

var interpreted = "an interpreted string \u2014 with a dash" // want `^This string holds an em-dash written as itself\.`

var interpretedEnDash = "pages 3\u20137" // want `^This string holds an en-dash.*\\u2013`

var twoDashes = "one \u2014 and \u2014 two" // want `^This string holds an em-dash` `^This string holds an em-dash`

var raw = `a raw string — with a dash` // want `^This raw string holds an em-dash\.`

// want +2 `^This raw string holds an en-dash.*\\u2013`
var rawAcrossLines = `a raw string
whose second line holds the dash, pages 3–7`

// The escaped dash is data and stays quiet; only the written one is reported and rewritten.
var writtenAndEscaped = "one written \u2014 and one escaped \u2014" // want `^This string holds an em-dash`

func use() []any {
	return []any{interpreted, interpretedEnDash, twoDashes, raw, rawAcrossLines, writtenAndEscaped}
}
