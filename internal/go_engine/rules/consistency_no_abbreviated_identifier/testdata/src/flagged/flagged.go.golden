// Package flagged declares an abbreviated name of every kind Go has, in every form the vocabulary judges.
package flagged

import (
	"context"
	"foreign"
	"sort"
	"time"
)

// A package-level constant, in the prefix form.
const maximumRetries = 3 // want `Identifier "maxRetries" should not be abbreviated\. Use "maximumRetries"\.`

// A package-level variable, the whole word with its expansion or a more descriptive name.
var configuration = map[string]string{} // want `Identifier "cfg" should not be abbreviated\. Use "configuration" or a more descriptive name\.`

// An exported function, the word as a segment, since Go's capital opens a word as camelCase does.
func ParseConfiguration() {} // want `Identifier "ParseCfg" abbreviates "Cfg"\. Use "ParseConfiguration"\.`

// A type, in the prefix form.
type sourceFile struct { // want `Identifier "srcFile" should not be abbreviated\. Use "sourceFile"\.`
	// A field whose tag carries the external spelling is judged by its Go name all the same.
	Source string `json:"src"` // want `Identifier "Src" abbreviates "Src"\. Use "Source"\.`
	// The suffix form.
	ownerReference string // want `Identifier "ownerRef" should not end with "Ref"\. Use "ownerReference"\.`
}

// A method; a parameter whose bare expansion is a package this one imports, a context, named for its caller instead;
// a named result whose bare expansion is predeclared, which gets the descriptive advice instead of the expansion.
func (file *srcFile) readBuffer( // want `Identifier "readBuf" abbreviates "Buf"\. Use "readBuffer"\.`
	callerContext context.Context, // want `Identifier "ctx" should not be abbreviated\. Use "callerContext", named for where the context came from\.`
) (err error) { // want `Identifier "err" should not be abbreviated\. Use a descriptive name ending in "Error", since "error" is already Go's name for something else\.`
	return ctx.Err()
}

// A receiver.
func (configurationFile *srcFile) describe() string { // want `Identifier "cfgFile" should not be abbreviated\. Use "configurationFile"\.`
	return cfgFile.ownerRef
}

// A method named like sort.Interface's Len with another signature implements nothing, so its name is ours.
func (file *srcFile) Length() string { // want `Identifier "Len" abbreviates "Len"\. Use "Length"\.`
	return file.Src
}

// A Len with sort.Interface's exact signature, on a type that implements none of the rest, is ours all the same: the
// name is fixed only when the whole interface is implemented.
type halfSorter []int

func (list halfSorter) Length() int { return len(list) } // want `Identifier "Len" abbreviates "Len"\. Use "Length"\.`

var _ = sort.Ints

// An interface method of ours that no other package's method matches.
type sizer interface {
	bufferLen() int // want `Identifier "bufLen" should not be abbreviated\. Use "bufferLen"\.`
}

// A type parameter, in the suffix form.
func first[Res any](values []Res) Res { // want `Identifier "Res" should not end with "Res"\. Use "Result", "Response", "Resource" or "Reserve", whichever it means\.`
	return values[0]
}

// A label, range variables, a type switch variable, a local constant, and local variables in the advice forms.
func walk(values []any) {
indexLoop: // want `Identifier "idxLoop" should not be abbreviated\. Use "indexLoop"\.`
	for index, value := range values { // want `Identifier "idx" should not be abbreviated\. Use "index" or a more descriptive name\.` `Identifier "val" should not be abbreviated\. Use "value" or a more descriptive name\.`
		switch str := val.(type) { // want `Identifier "str" should not be abbreviated\. Use a descriptive name ending in "String", since "string" is already Go's name for something else\.`
		case string:
			_ = str
			continue idxLoop
		}
		_ = idx
	}
	const timeoutInMilliseconds = 5 // want `Identifier "timeoutMs" should not abbreviate milliseconds as "Ms"\. Use "timeoutInMilliseconds"`
	fn := func() {}     // want `Identifier "fn" should not be abbreviated\. Use "callback", "handler", "factory", or a more descriptive name\.`
	fn()
	argCount := len(values) // want `Identifier "arg" should not be abbreviated\. Use "argument", "commandArgument", or a more descriptive name\.`
	_ = argCount
	_ = time.Duration(timeoutMs)
}

// Words with more than one meaning. `pos` names both of its own and asks for whichever it is, here positive beside a
// negative; `sb` fits more words than a list could hold, here a scroll region's bottom, so it asks what it holds.
func scroll(
	pos int, // want `Identifier "pos" should not be abbreviated\. Use "position" or "positive", whichever it means, or a more descriptive name\.`
	sb int, // want `Identifier "sb" should not be abbreviated\. Spell out what it holds\.`
	resultPos bool, // want `Identifier "resultPos" abbreviates "Pos"\. Use "resultPosition" or "resultPositive", whichever it means\.`
	resultNeg bool,
	scrollSbOffset int, // want `Identifier "scrollSbOffset" abbreviates "Sb"\. Spell out what it holds\.`
) {
	_, _, _, _, _ = pos, sb, resultPos, resultNeg, scrollSbOffset
}

// A Cmd with foreign.Commander's exact signature, on a type that implements none of the rest, is ours.
type halfShell struct{}

func (halfShell) Command() string { return "" } // want `Identifier "Cmd" abbreviates "Cmd"\. Use "Command"\.`

var _ foreign.Commander

// A Src with the shape of foreign.Source's, on a type that implements none of the rest of Source[int], is ours.
type halfReader struct{}

func (halfReader) Source() int { return 0 } // want `Identifier "Src" abbreviates "Src"\. Use "Source"\.`

// A Src that shares only the name of foreign.Source's, with another shape, implements no instance of it.
type wideReader struct{}

func (wideReader) Source(name string) int { return 0 } // want `Identifier "Src" abbreviates "Src"\. Use "Source"\.`

// An interface method of ours sharing only the name of foreign.Commander's Cmd, with another shape, is written to accept
// no type that has Commander's, so the name is ours. The verdict holds an unanswered lookup across builds that gain a
// method of another shape on this alone (methodLookupHolds).
type commanding interface {
	Command(name string) string // want `Identifier "Cmd" abbreviates "Cmd"\. Use "Command"\.`
}

// A generic receiver's method sharing only the name of sort.Interface's Len, with another shape, is not taken as fixed
// by it, as stack's Len of the same signature is in lookalike.
type wideStack[Item any] []Item

func (items wideStack[Item]) Length(extra int) int { return len(items) + extra } // want `Identifier "Len" abbreviates "Len"\. Use "Length"\.`

// A segment keeps the name's case shape, so an unexported name stays unexported and an exported one exported.
func parseConfigurationFile() {} // want `Identifier "parseCfgFile" abbreviates "Cfg"\. Use "parseConfigurationFile"\.`

var MaxLength = 3 // want `Identifier "MaxLen" abbreviates "Len"\. Use "MaxLength"\.`

// The prefix form keeps the rest of the name.
var configurationPath = "" // want `Identifier "cfgPath" should not be abbreviated\. Use "configurationPath"\.`
