// Package crowded holds one long call in a file whose long-file limit a case sets, with room for its wrap or without.
package crowded

import "fmt"

// Describe says where a delivery goes, in one call a wrap breaks one argument per line.
func Describe(sender string, recipient string, street string, city string) string {
	return fmt.Sprintf(
		"%s sends a parcel to %s, who lives at %s in %s, and it arrives soon",
		sender,
		recipient,
		street,
		city,
	)
}
