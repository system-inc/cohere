.gitignore:8:\#literal	#literal
::	.gitignore
::	a
::	a/b
::	a/b/deep
.gitignore:7:**/deep/x	a/b/deep/x
.gitignore:5:/anchored	anchored
.gitignore:3:*.log	app.log
::	docs
.gitignore:6:docs/generated	docs/generated
::	docs/written
.gitignore:9:escaped\ 	escaped 
.gitignore:4:!keep.log	keep.log
.gitignore:11:!kept-by-gitignore	kept-by-gitignore
.git/info/exclude:2:per-repository	per-repository
::	plain.txt
::	sub
::	sub/.gitignore
::	sub/anchored
sub/.gitignore:1:!*.log	sub/app.log
::	sub/docs
::	sub/docs/generated
::	sub/inner
::	sub/inner/.gitignore
sub/.gitignore:2:local	sub/inner/local
sub/inner/.gitignore:1:*.txt	sub/inner/plain.txt
::	sub/inner/rooted
sub/.gitignore:2:local	sub/local
.git/info/exclude:2:per-repository	sub/per-repository
sub/.gitignore:3:/rooted	sub/rooted
.gitignore:10:trailing	trailing
